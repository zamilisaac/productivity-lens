<!DOCTYPE html>
<html><head><meta charset="utf-8">
<style>
{% for w, f in [(400,'Regular'),(500,'Medium'),(600,'SemiBold'),(700,'Bold')] %}@font-face { font-family: "Geist"; src: url("{{ fonts }}/Geist-{{ f }}.ttf") format("truetype"); font-weight: {{ w }}; }
{% endfor %}
:root { --ink:#0B0B0F; --ink2:#2A2A33; --muted:#5A5A66; --line:#E2E0E8; --soft:#F5F4F8; --lime:#D4F542; --lime-ink:#2F3A05; --violet:#9466FF; --violet-ink:#4B2A9E; --violet-soft:#EFE8FF; }
* { box-sizing: border-box; }
html, body { margin: 0; }
.card { width: 1080px; height: 1350px; padding: 72px 72px 64px; background: #fff; color: var(--ink); font-family: "Geist", Arial, sans-serif;
        font-size: 32px; line-height: 1.4; display: flex; flex-direction: column; overflow: hidden; }
.top { display: flex; justify-content: space-between; align-items: center; gap: 24px; }
.brand { display: flex; align-items: center; gap: 18px; font-weight: 600; font-size: 30px; }
.brand svg { width: 60px; height: 60px; }
.pill { font-size: 28px; font-weight: 500; background: var(--soft); border: 2px solid var(--line); border-radius: 99px; padding: 6px 22px; color: var(--ink2); white-space: nowrap; }
.main { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 34px; overflow: hidden; padding: 24px 0; }
.kicker { display: inline-block; align-self: flex-start; background: var(--lime); color: var(--lime-ink); font-weight: 600; font-size: 28px; border-radius: 10px; padding: 6px 18px; }
.co { font-size: 30px; color: var(--muted); font-weight: 500; }
h1 { font-weight: 600; font-size: 68px; line-height: 1.08; letter-spacing: -.025em; margin: 0; }
h2 { font-weight: 600; font-size: 54px; line-height: 1.12; letter-spacing: -.02em; margin: 0; }
.big { font-weight: 600; font-size: 150px; line-height: .95; letter-spacing: -.04em; color: var(--violet-ink); }
.verdict { display: inline-block; align-self: flex-start; background: var(--violet-soft); color: var(--violet-ink); font-weight: 600; font-size: 30px; border-radius: 99px; padding: 6px 22px; }
.rows { display: flex; flex-direction: column; gap: 18px; }
.row { display: flex; gap: 28px; align-items: center; border: 2px solid var(--line); border-radius: 22px; padding: 22px 28px; }
.row.first { border-top: 6px solid var(--violet); }
.row .n { font-weight: 600; font-size: 60px; letter-spacing: -.03em; min-width: 330px; line-height: 1.05; }
.row .t { font-size: 30px; font-weight: 500; line-height: 1.25; }
.row .t small { display: block; font-size: 28px; font-weight: 400; color: var(--muted); margin-top: 6px; }
.box { background: var(--soft); border-radius: 22px; padding: 28px 32px; }
.box .h { font-size: 28px; font-weight: 600; color: var(--violet-ink); margin-bottom: 6px; }
p { margin: 0; }
.src { font-size: 28px; color: var(--muted); border-top: 2px solid var(--line); padding-top: 22px; }
.chart svg { width: 100%; height: auto; }
</style></head>
<body><div class="card" id="card">
{%- set MARK -%}<svg viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="16" fill="#0B0B0F"/><circle cx="32" cy="32" r="17" fill="none" stroke="#D4F542" stroke-width="5"/><circle cx="32" cy="32" r="7" fill="#9466FF"/></svg>{%- endset -%}
{%- set cname = c.company | replace(' Berhad','') | replace(' Bhd','') -%}
<div class="top"><div class="brand">{{ MARK | safe }}{{ L.brand }}</div><span class="pill">{{ cname }} · FY{{ c.fy }}</span></div>
<div class="main">
{% if kind == 'headline' %}
  <span class="kicker">{{ L.spotlight }}</span>
  <h1>{{ c.short_headline or c.headline }}</h1>
  <div class="rows">{% for r in c.headline_results %}<div class="row{{ ' first' if loop.first }}"><span class="n">{{ r.big }}</span><span class="t">{{ r.label[:1] | upper }}{{ r.label[1:] }}</span></div>{% endfor %}</div>
{% elif kind == 'snapshot' %}
  <span class="kicker">{{ L.productivity_snapshot }}</span>
  <div class="rows">{% for s in c.snapshot.indicators %}<div class="row{{ ' first' if loop.first }}">
    <span class="n">{{ s.fy_display }}</span><span class="t">{{ s.label }}<small>{{ s.change_display }} · {{ L.peer }}: {{ s.median_display }}</small></span></div>{% endfor %}</div>
{% elif kind == 'dtf' %}
  <span class="kicker">{{ c.dtf.title }}</span>
  <div class="big">{{ c.dtf.big_display }}</div>
  {% if c.dtf.verdict %}<span class="verdict">{{ c.dtf.verdict }}</span>{% endif %}
  <div class="chart">{{ chart_svg | safe }}</div>
  <p>{{ c.dtf.card_sentence }}</p>
{% elif kind == 'lesson' %}
  <span class="kicker">{{ L.lesson }} {{ lesson_no }}</span>
  <p class="co">{{ L.sme_lessons }}</p>
  <h2>{{ lesson.title }}</h2>
  <p>{{ lesson.did }}</p>
  <div class="box"><div class="h">{{ L.starter }}</div><p>{{ lesson.starter }}</p></div>
{% endif %}
</div>
<div class="src">{{ L.source }}: {{ c.company }} {{ L.annual_report }} FY{{ c.fy }}, {{ L.pp if ',' in (src_page|string) or ';' in (src_page|string) else L.p }}{{ src_page }}</div>
</div></body></html>
