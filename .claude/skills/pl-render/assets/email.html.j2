<!DOCTYPE html>
{%- set F = "-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif" -%}
{%- set cname = c.company | replace(' Berhad','') | replace(' Bhd','') -%}
<html lang="en-GB"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ subject }}</title></head>
<body style="margin:0;padding:0;background:#F5F4F8;">
<div style="display:none;max-height:0;overflow:hidden;">{{ preview }}</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#F5F4F8;"><tr><td align="center" style="padding:20px 8px;">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:100%;max-width:600px;background:#ffffff;border:1px solid #E2E0E8;border-radius:14px;font-family:{{ F }};color:#0B0B0F;font-size:15px;line-height:1.55;">
<tr><td style="padding:20px 24px 0;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr>
  <td style="font-size:15px;font-weight:600;"><span style="display:inline-block;width:22px;height:22px;background:#0B0B0F;border-radius:6px;vertical-align:middle;text-align:center;line-height:22px;"><span style="display:inline-block;width:8px;height:8px;border:2px solid #D4F542;border-radius:50%;vertical-align:middle;"></span></span>&nbsp; {{ L.brand }}</td>
  <td align="right" style="font-size:13px;color:#2A2A33;"><span style="background:#F5F4F8;border:1px solid #E2E0E8;border-radius:99px;padding:3px 10px;">{{ cname }} · FY{{ c.fy }}</span></td>
  </tr></table></td></tr>
<tr><td style="padding:22px 24px 6px;">
  <span style="display:inline-block;background:#D4F542;color:#2F3A05;font-size:13px;font-weight:600;border-radius:6px;padding:2px 9px;">{{ L.spotlight }}</span>
  <h1 style="font-size:27px;font-weight:600;line-height:1.18;letter-spacing:-0.4px;margin:12px 0 10px;">{{ c.short_headline or c.headline }}</h1>
  <p style="margin:0;color:#2A2A33;">{{ c.email_intro }}</p></td></tr>
<tr><td style="padding:16px 24px 0;"><p style="margin:0 0 10px;color:#4B2A9E;font-weight:600;font-size:14px;">{{ L.ch_results }}</p>
{% for r in c.headline_results %}
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #E2E0E8;{% if loop.first %}border-top:3px solid #9466FF;{% endif %}border-radius:10px;margin-bottom:10px;"><tr><td style="padding:12px 16px;">
  <div style="font-size:28px;font-weight:600;line-height:1.1;letter-spacing:-0.5px;">{{ r.big }}</div>
  <div style="font-weight:600;">{{ r.label[:1] | upper }}{{ r.label[1:] }}</div>
  <div style="color:#5A5A66;font-size:13px;">{{ r.context }} · {{ L.pp if ',' in (r.page|string) or ';' in (r.page|string) else L.p }}{{ r.page }}</div></td></tr></table>
{% endfor %}</td></tr>
<tr><td style="padding:8px 24px;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#F5F4F8;border-radius:10px;"><tr><td style="padding:16px;">
  <p style="margin:0 0 10px;color:#4B2A9E;font-weight:600;font-size:14px;">{{ L.productivity_snapshot }} · FY{{ c.fy }}</p>
  {% for s in c.snapshot.indicators %}<p style="margin:0 0 10px;font-size:13px;color:#5A5A66;">{{ s.label }}<br>
  <span style="font-size:22px;font-weight:600;color:#0B0B0F;">{{ s.fy_display }}</span>
  <span> {{ s.change_display }} · {{ L.peer }}: {{ s.median_display }}</span></p>{% endfor %}
</td></tr></table></td></tr>
<tr><td style="padding:8px 24px 12px;"><p style="margin:0;color:#4B2A9E;font-weight:600;font-size:14px;">{{ c.dtf.title }}</p>
  <p style="margin:4px 0 0;">{{ c.dtf.email_line }}</p></td></tr>
<tr><td style="padding:4px 24px;"><p style="margin:0 0 10px;color:#4B2A9E;font-weight:600;font-size:14px;">{{ L.sme_lessons }}</p>
{% if not c.lessons %}<p style="margin:0 0 12px;color:#2A2A33;">{{ c.lessons_note }}</p>{% endif %}
{% for l in c.lessons %}<div style="border-left:3px solid #D4F542;padding-left:12px;margin-bottom:14px;">
  <div style="font-size:17px;font-weight:600;line-height:1.3;">{{ l.title }}</div>
  <div>{{ l.did_short }}</div><div><b>{{ L.starter }}:</b> {{ l.starter }}</div></div>{% endfor %}</td></tr>
<tr><td style="padding:8px 24px;font-size:14px;">
  <p style="margin:0 0 4px;"><b>Full spotlight (EN):</b> {{ links.spotlight_pdf }}</p>
  <p style="margin:0 0 4px;"><b>Versi BM:</b> {{ links.bm_pdf }}</p>
  <p style="margin:0;"><b>Snapshots:</b> {{ links.snapshots }}</p></td></tr>
<tr><td style="padding:8px 24px;"><p style="margin:0;padding:10px 12px;border-radius:8px;background:{{ '#EFE8FF' if c.audit_status.startswith('Ready') else '#FBE9E5' }};font-size:14px;"><b>Status:</b> {{ c.audit_status }}</p></td></tr>
<tr><td style="padding:14px 24px 22px;color:#5A5A66;font-size:13px;border-top:1px solid #E2E0E8;">
  {{ L.source }}: {{ c.company }} {{ L.annual_report }} FY{{ c.fy }}. Figures as reported, not independently audited. Not investment advice. DRAFT – not for distribution until reviewed.</td></tr>
</table></td></tr></table></body></html>
